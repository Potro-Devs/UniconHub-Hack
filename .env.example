PORT=3000
SQLITE_DB_PATH=./data/axi.db
# En producción: valor aleatorio de al menos 32 caracteres (p. ej. `openssl rand -hex 32`).
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1

# Autenticación (opcional)
TEACHER_TOKEN_TTL=8h
STUDENT_TOKEN_TTL=2h
# Botones "Entrar como Docente / Directivo / Alumno". Por defecto: activos fuera de producción.
# ENABLE_QUICK_LOGIN=true
QUICK_LOGIN_TEACHER_EMAIL=docente@axi.demo
QUICK_LOGIN_DIRECTOR_EMAIL=direccion@axi.demo

# Acceso del alumno (opcional). Un salón suele compartir la misma IP: el límite por IP es amplio.
# AUTH_STUDENT_JOIN_MAX=600
# Intentos FALLIDOS de imagen secreta por alumno en 15 min antes de pedir ayuda a la maestra.
# AUTH_SECRET_ATTEMPTS_MAX=8
